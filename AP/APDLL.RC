AP_CANCELBATCH DIALOG 23, 37, 299, 154
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CLASS "BorDlg"
CAPTION "Cancel Accounts Payable Journal"
FONT 8, "Helv"
{
 CONTROL "", 105, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 7, 6, 226, 41
 LTEXT "W A R N I N G!!!\n\n This function will cancel the slip that you specify.", -1, 10, 9, 146, 35
 CONTROL "tbSpread", ID_DISTLIST, "tbSpread", 128 | WS_CHILD | WS_VISIBLE | WS_BORDER, 6, 78, 287, 70
 LTEXT "Double click on the item which you wish to cancel.", -1, 158, 11, 70, 30
 LTEXT "", 3031, 103, 58, 29, 11
 LTEXT "Cancel Slip Number :", -1, 9, 59, 87, 8
 CONTROL "", 106, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 6, 52, 137, 23
 PUSHBUTTON "&Cancel", 2, 242, 11, 51, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
}

