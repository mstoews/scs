
PRINTSETUP DIALOG LOADONCALL MOVEABLE DISCARDABLE 10, 35, 201, 80
STYLE WS_POPUP | WS_DLGFRAME
CAPTION "Printer Setup"
BEGIN
	CONTROL "&Printer:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 6, 4, 67, 8
	CONTROL "", 201, "LISTBOX", LBS_STANDARD | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 17, 134, 49
	CONTROL "OK", 100, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 150, 7, 41, 14
	CONTROL "Cancel", 101, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 150, 24, 41, 14
	CONTROL "&Setup...", 200, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 151, 50, 41, 14
END


