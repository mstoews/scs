OPENF2 DIALOG LOADONCALL MOVEABLE DISCARDABLE 43, 28, 159, 122
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CLASS "BorDlg"
CAPTION "Open File"
FONT 8, "Helv"
BEGIN
	CONTROL "File:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 9, 11, 18, 8
	CONTROL "", 300, "EDIT", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 32, 10, 94, 12
	CONTROL "Files in:", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 10, 35, 31, 8
	CONTROL "C:\\WIN\\TEST", 303, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 48, 35, 97, 8
	CONTROL "", 301, "LISTBOX", LBS_STANDARD | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 56, 75, 65
	DEFPUSHBUTTON "Open", 100, 107, 58, 43, 14
	PUSHBUTTON "Cancel", 2, 107, 78, 43, 14
	CONTROL "", 101, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 3, 6, 150, 19
	CONTROL "", 101, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 3, 30, 150, 19
END


FONT DIALOG LOADONCALL MOVEABLE DISCARDABLE 89, 27, 177, 121
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Select Font"
BEGIN
	CONTROL "&Font", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 7, 8, 21, 10
	CONTROL "", 600, "LISTBOX", LBS_STANDARD | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 7, 19, 57, 49
	CONTROL "", 601, "EDIT", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 6, 72, 58, 12
	CONTROL "&Size", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE, 73, 8, 21, 10
	CONTROL "", 602, "LISTBOX", LBS_NOTIFY | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 73, 19, 28, 49
	CONTROL "", 603, "EDIT", ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 72, 72, 29, 12
	CONTROL "Style", -1, "BUTTON", BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 107, 7, 54, 62
	CONTROL "&Bold", 604, "BUTTON", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 112, 18, 28, 12
	CONTROL "&Italic", 605, "BUTTON", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 112, 30, 35, 12
	CONTROL "&Underline", 606, "BUTTON", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 112, 42, 48, 12
	CONTROL "Stri&keout", 608, "BUTTON", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 112, 54, 48, 12
	CONTROL "&Printer Fonts", 609, "BUTTON", BS_CHECKBOX | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 107, 72, 63, 12
	CONTROL "Ok", 100, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 36, 103, 44, 14
	CONTROL "", 610, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE, 7, 87, 161, 12
	CONTROL "Cancel", 2, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 85, 103, 44, 14
END


